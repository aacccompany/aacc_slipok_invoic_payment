<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_aacc_slipok_invoice_payment" model="ir.ui.view">
        <field name="name">account.move.form.inherit.aacc.slipok.invoice.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_send_line_invoice_bill"
                    type="object"
                    string="Send Bill via LINE"
                    class="btn-secondary"
                    invisible="move_type != 'out_invoice' or state != 'posted' or payment_state in ['in_payment', 'paid']"
                />
                <button
                    name="action_verify_slip_and_register_payment"
                    type="object"
                    string="Verify Slip"
                    class="btn-primary"
                    invisible="move_type != 'out_invoice' or state != 'posted' or payment_state in ['in_payment', 'paid']"
                />
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Slip Verification" name="slip_page" invisible="move_type != 'out_invoice'">
                    <group>
                        <group>
                            <field name="line_user_id"/>
                            <field name="is_active_line_bill" readonly="1"/>
                            <field name="line_payment_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="slip_image" filename="slip_image_filename"/>
                            <field name="slip_image_filename" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="slip_state" readonly="1"/>
                            <field name="slip_message" readonly="1"/>
                            <field name="slip_verified_at" readonly="1"/>
                            <field name="slip_transaction_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="slip_verified_amount" readonly="1"/>
                            <field name="slip_receiver_account" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="slip_response" readonly="1" nolabel="1" widget="text"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
